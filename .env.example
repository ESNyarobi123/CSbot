# Generate the password and token with: openssl rand -hex 32
POSTGRES_PASSWORD=
ADMIN_API_TOKEN=
# Generate once and save securely. Rotating it requires re-pairing: openssl rand -base64 32
SESSION_KEY=
# Docker chooses an available loopback port. Set 8080 for a fixed reverse proxy.
CSBOT_HTTP_PORT=0
ALLOW_MOCK=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Baileys syncs WhatsApp Web history for a newly linked number. Set to false to import metadata only.
SYNC_FULL_HISTORY=true

# CSolution POS PostgreSQL user granted SELECT only on the two views in integrations/csolution-pos.sql.
CSOLUTION_POS_DB_URL=
# Live product catalog. Point these at CSolution's GET /api/csbot/* routes and
# reuse the CSBOT_CATALOG_TOKEN from the CSolution .env file. From Docker use
# http://host.docker.internal:3085/api/csbot/ to reach a server on the host.
POS_BASE_URL=
POS_API_TOKEN=
POS_BRANCH_ID=
# Exact HTTPS hostnames (comma-separated). Configured CSolution POS images use its read-only database.
PRODUCT_IMAGE_HOSTS=

WOTEFY_PLANS_URL=https://ssdomada.site/api/v1/plans
LUBFY_PLANS_URL=https://lubfy.online/v1/public/plans

WORKER_CONCURRENCY=4
DEBOUNCE_MS=1250
# A manual conversation stays with the operator until they enable CSbot.
HANDOFF_IDLE_MINUTES=0
# Receipt photos forwarded to admin are kept in PostgreSQL for this many days.
MEDIA_RETENTION_DAYS=90
